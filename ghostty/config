theme       = Catppuccin Mocha

font-family = JetBrains Mono
font-style  = Medium
font-size   = 13

# Increase line height
adjust-cell-height = +5%

# macOS specific configuration
macos-icon          = xray
macos-option-as-alt = true

# Remove notification badge from the dock icon
bell-features = title,no-attention

# Do not dim inactive splits
unfocused-split-opacity = 1

# Do not restore size from previous window
window-width  = 120
window-height = 40
